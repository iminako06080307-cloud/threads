# ========================================
# 環境変数サンプル。 .env にコピーして値を設定してください。
#   cp .env.example .env
# ========================================

# --- データベース (SQLite) ---
DATABASE_URL="file:./dev.db"

# --- Claude API (コンテンツ生成) ---
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=""
# 生成に使うモデル (未設定なら claude-sonnet-5)
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Threads API (投稿) ---
# Meta for Developers でアプリを作成し、Threads の権限
# (threads_basic, threads_content_publish) を付けてトークンを取得。
#   https://developers.facebook.com/docs/threads/get-started
# Threads ユーザーID (数字)
THREADS_USER_ID=""
# 長期アクセストークン (60日有効。定期的に更新が必要)
THREADS_ACCESS_TOKEN=""
# APIバージョン
THREADS_API_VERSION="v1.0"

# --- 誘導CTA (任意) ---
# 設定すると、生成した投稿の最後に「別チャネルへの誘導」の連投が自動追加されます。
# Instagram / LINE は両方でも片方でも設定可。空のものは付きません。

# Instagram誘導: ユーザー名だけでOK (例: mydiet_account)。@は付けても付けなくても可。
IG_USERNAME=""
# または完全なURLで指定したい場合 (IG_USERNAME より優先)
IG_CTA_URL=""
# 文面 (未設定なら既定文)。{url} はインスタURLに置き換わります。
IG_CTA_MESSAGE=""

# 公式LINE誘導: LINEの友だち追加URL (例: https://lin.ee/xxxxxxx)
LINE_CTA_URL=""
# 文面 (未設定なら既定文)。{url} はLINE URLに置き換わります。
LINE_CTA_MESSAGE=""

# 勉強会・サポート生募集(SEMINARフォーマット)の参加先URL。
# 未設定なら LINE_CTA_URL にフォールバックします。
SEMINAR_CTA_URL=""
# 文面 (未設定なら「▼参加はこちら▼ + URL」)。{url} が置き換わります。
SEMINAR_CTA_MESSAGE=""

# --- スケジューラ ---
# 予約投稿ワーカーが未来の投稿をチェックする間隔(秒)
SCHEDULER_INTERVAL_SECONDS="60"
